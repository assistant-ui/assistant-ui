{
  "name": "assistant-ui-vscode-starter",
  "displayName": "Assistant",
  "description": "An assistant-ui chat in the VS Code side bar.",
  "version": "0.1.0",
  "private": true,
  "publisher": "your-publisher",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "dev": "tsx scripts/build.mts --watch",
    "build": "tsx scripts/build.mts",
    "typecheck": "tsc --noEmit",
    "package": "npm run build && npx @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "auiAssistant",
          "title": "Assistant",
          "icon": "media/assistant.svg"
        }
      ]
    },
    "views": {
      "auiAssistant": [
        {
          "type": "webview",
          "id": "auiAssistant.chat",
          "name": "Assistant"
        }
      ]
    },
    "commands": [
      {
        "command": "auiAssistant.setApiKey",
        "title": "Set OpenAI API Key",
        "category": "Assistant"
      }
    ]
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.102",
    "@assistant-ui/ai-sdk": "workspace:*",
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/react-markdown": "workspace:*",
    "@assistant-ui/ui": "workspace:*",
    "@assistant-ui/vscode": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "ai": "^7.0.153",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.110.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
