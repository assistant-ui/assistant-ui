    "@assistant-ui/ui": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@langchain/anthropic": "^1.6.0",
    "@langchain/langgraph": "^1.6.0",
    "@langchain/langgraph-sdk": "^1.12.9",
    "@langchain/react": "^1.2.9",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.14",
    "zustand": "^5.0.16"
