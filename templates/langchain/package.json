    "@assistant-ui/ui": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@langchain/anthropic": "^1.6.1",
    "@langchain/langgraph": "^1.7.2",
    "@langchain/langgraph-sdk": "^1.15.0",
    "@langchain/react": "^1.2.13",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.70.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
