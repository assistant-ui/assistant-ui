{
  "name": "assistant-ui-starter-langchain",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n frontend,backend -c cyan,magenta \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "next dev --turbopack",
    "dev:backend": "langgraphjs dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && oxfmt --check",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "lint:fix": "oxlint --fix && oxfmt"
  },
  "dependencies": {
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/react-langchain": "workspace:*",
    "@assistant-ui/react-markdown": "workspace:*",
    "@base-ui/react": "^1.7.0",
    "@langchain/anthropic": "^1.5.8",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/react": "^1.0.33",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.4",
    "lucide-react": "^1.38.0",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-gfm": "^4.0.1",
    "tw-animate-css": "^1.4.0",
    "tw-shimmer": "^0.4.12",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@assistant-ui/next": "workspace:*",
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph-cli": "^1.4.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
