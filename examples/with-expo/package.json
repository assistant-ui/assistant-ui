{
  "name": "with-expo",
  "main": "expo-router/entry",
  "version": "0.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web && node scripts/flatten-assets.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@ai-sdk/react": "^4.0.163",
    "@assistant-ui/ai-sdk": "workspace:*",
    "@assistant-ui/react-native": "workspace:*",
    "@assistant-ui/ui": "workspace:*",
    "@expo/metro-runtime": "~58.0.16",
    "ai": "^7.0.159",
    "cn": "^0.5.1",
    "expo": "~58.0.22",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.29",
    "expo-server": "~58.0.6",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "lucide-react-native": "^1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-marked": "^8.3.3",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "uniwind": "^1.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@assistant-ui/metro": "workspace:*",
    "@babel/core": "^7.29.7",
    "@react-native/metro-config": "0.88.1",
    "@types/react": "~19.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
