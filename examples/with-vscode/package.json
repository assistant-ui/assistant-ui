{
  "name": "with-vscode",
  "displayName": "assistant-ui Test Bed",
  "description": "Test bed for running assistant-ui inside a VS Code extension webview.",
  "version": "0.0.0",
  "private": true,
  "publisher": "assistant-ui",
  "engines": {
    "vscode": "^1.110.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsx scripts/build.mts",
    "dev": "tsx scripts/build.mts --watch",
    "test": "tsx scripts/build.mts && tsx test/run.mts",
    "screenshots": "tsx scripts/build.mts && tsx test/run.mts --screenshots",
    "typecheck": "tsc --noEmit"
  },
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "auiTest",
          "title": "Assistant",
          "icon": "media/assistant.svg"
        }
      ],
      "panel": [
        {
          "id": "auiTestPanel",
          "title": "Assistant",
          "icon": "media/assistant.svg"
        }
      ]
    },
    "views": {
      "auiTest": [
        {
          "type": "webview",
          "id": "auiTest.assistant",
          "name": "Assistant",
          "when": "config.auiTest.location == 'sidebar'"
        },
        {
          "id": "auiTest.readiness",
          "name": "Readiness"
        }
      ],
      "auiTestPanel": [
        {
          "type": "webview",
          "id": "auiTest.assistantPanel",
          "name": "Assistant",
          "when": "config.auiTest.location == 'panel'"
        }
      ]
    },
    "commands": [
      {
        "command": "auiTest.runAllProbes",
        "title": "Run All Probes",
        "category": "AUI Test Bed",
        "icon": "$(run-all)"
      },
      {
        "command": "auiTest.runProbe",
        "title": "Run Probe",
        "category": "AUI Test Bed",
        "icon": "$(play)"
      },
      {
        "command": "auiTest.showAssistant",
        "title": "Show Assistant",
        "category": "AUI Test Bed"
      },
      {
        "command": "auiTest.reloadWebview",
        "title": "Reload Assistant Webview",
        "category": "AUI Test Bed",
        "icon": "$(refresh)"
      },
      {
        "command": "auiTest.openSettings",
        "title": "Open Switchboard Settings",
        "category": "AUI Test Bed",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "auiTest.runAllProbes",
          "when": "view == auiTest.readiness",
          "group": "navigation@1"
        },
        {
          "command": "auiTest.reloadWebview",
          "when": "view == auiTest.readiness",
          "group": "navigation@2"
        },
        {
          "command": "auiTest.openSettings",
          "when": "view == auiTest.readiness",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "auiTest.runProbe",
          "when": "view == auiTest.readiness && viewItem == probe",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "auiTest.runProbe",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "AUI Test Bed",
      "properties": {
        "auiTest.runtime": {
          "type": "string",
          "enum": [
            "ai-sdk",
            "data-stream",
            "assistant-transport",
            "local"
          ],
          "enumDescriptions": [
            "useChatRuntime with AssistantChatTransport",
            "useDataStreamRuntime",
            "useAssistantTransportRuntime",
            "useLocalRuntime with a ChatModelAdapter"
          ],
          "default": "local",
          "description": "Runtime the webview mounts."
        },
        "auiTest.backend": {
          "type": "string",
          "enum": [
            "fixture",
            "anthropic",
            "vscode-lm"
          ],
          "enumDescriptions": [
            "Scripted fixture replies, no network or API key",
            "Anthropic API called from the extension host",
            "vscode.lm chat models"
          ],
          "default": "fixture",
          "description": "Backend that answers the webview."
        },
        "auiTest.style": {
          "type": "string",
          "enum": [
            "shadcn",
            "vscode"
          ],
          "enumDescriptions": [
            "Default shadcn components themed by @assistant-ui/vscode/theme.css",
            "VS Code-native component style"
          ],
          "default": "shadcn",
          "description": "Theme applied to the webview."
        },
        "auiTest.csp": {
          "type": "string",
          "enum": [
            "strict",
            "relaxed"
          ],
          "enumDescriptions": [
            "Nonce-only scripts and styles",
            "Allows inline styles"
          ],
          "default": "strict",
          "description": "Content Security Policy of the webview."
        },
        "auiTest.location": {
          "type": "string",
          "enum": [
            "sidebar",
            "panel",
            "editor"
          ],
          "enumDescriptions": [
            "Secondary side bar view",
            "Panel view",
            "Editor tab"
          ],
          "default": "sidebar",
          "description": "Where the Assistant webview is shown."
        }
      }
    }
  },
  "dependencies": {
    "@assistant-ui/ai-sdk": "workspace:*",
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/ui": "workspace:*",
    "@assistant-ui/vscode": "workspace:*",
    "ai": "^7.0.101",
    "assistant-stream": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.46.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.110.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2"
  }
}
