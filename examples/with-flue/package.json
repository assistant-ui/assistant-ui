{
  "name": "with-flue",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n server,ui -c blue,magenta \"pnpm dev:server\" \"pnpm dev:ui\"",
    "dev:server": "vite dev --port 8791",
    "dev:ui": "vite dev --config vite.config.ui.ts --port 5173",
    "build": "vite build && pnpm run build:ui",
    "build:ui": "vite build --config vite.config.ui.ts",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/flue": "workspace:*",
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/ui": "workspace:*",
    "@flue/runtime": "^2.3.0",
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "@flue/vite": "^2.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
