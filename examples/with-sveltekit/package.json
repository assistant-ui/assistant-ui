{
  "name": "with-sveltekit",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "prepare": "svelte-kit sync",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test build-cache.test.mjs",
    "test:coverage": "pnpm run test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.106",
    "@assistant-ui/ai-sdk": "workspace:*",
    "@assistant-ui/core": "workspace:*",
    "@assistant-ui/store": "workspace:*",
    "@assistant-ui/svelte": "workspace:*",
    "@assistant-ui/tap": "workspace:*",
    "@lucide/svelte": "^1.66.0",
    "ai": "^7.0.159",
    "react": "^19.3.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^8.0.0",
    "@sveltejs/kit": "^3.1.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5"
  }
}
