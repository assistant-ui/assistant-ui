    "@assistant-ui/svelte": "workspace:*",
    "@assistant-ui/tap": "workspace:*",
    "@lucide/svelte": "^1.49.0",
    "ai": "^7.0.123",
    "react": "^19.3.0",
    "svelte": "^5.57.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "svelte-check": "^4.7.6",
