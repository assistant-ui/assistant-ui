{
  "name": "@assistant-ui/docs-tanstack-spike",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3399",
    "build": "vite build",
    "prebuild": "node -e \"for (const d of ['components','generated','content']) { try { require('fs').symlinkSync('../docs/'+d, d) } catch {} }\"",
    "build:measure": "rm -rf dist .output .source node_modules/.vite && python3 ../../spike/measure.py tanstack ../../spike/tanstack.log -- pnpm build"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "fumadocs-core": "16.17.8",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "16.17.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.2.0",
    "vite": "^8.3.5",
    "vite-tsconfig-paths": "^6.1.1",
    "@assistant-ui/vite": "workspace:*"
  }
}
