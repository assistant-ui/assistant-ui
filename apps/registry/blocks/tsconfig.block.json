{
  "extends": "@assistant-ui/x-buildutils/ts/base-node",
  "compilerOptions": {
    "paths": {
      "@/components/assistant-ui/*": [
        "../../../packages/ui/src/components/react/assistant-ui/*"
      ],
      "@/components/ui/*": [
        "../../../packages/ui/src/components/react/ui/base/*",
        "../../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/components/ui/radix/*": [
        "../../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/hooks/*": ["${configDir}/hooks/*", "../../../packages/ui/src/hooks/*"],
      "@/lib/*": ["${configDir}/lib/*", "../../../packages/ui/src/lib/*"],
      "@/*": ["${configDir}/*"]
    }
  }
}
