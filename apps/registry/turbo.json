{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/templates/**/api/**/*.ts",
        "$TURBO_ROOT$/templates/vscode/src/openai.ts",
        "$TURBO_ROOT$/apps/docs/components/pages/docs/fumadocs/install/packaged-file-url.ts",
        "$TURBO_ROOT$/examples/with-expo/**/*.{ts,tsx}",
        "!$TURBO_ROOT$/examples/with-expo/**/{node_modules,.next,dist,build}/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/templates/**/api/**/*.ts",
        "$TURBO_ROOT$/templates/vscode/src/openai.ts",
        "$TURBO_ROOT$/apps/docs/components/pages/docs/fumadocs/install/packaged-file-url.ts",
        "$TURBO_ROOT$/examples/with-expo/**/*.{ts,tsx}",
        "!$TURBO_ROOT$/examples/with-expo/**/{node_modules,.next,dist,build}/**"
      ]
    }
  }
}
