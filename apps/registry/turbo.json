{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/templates/**/api/**/*.ts",
        "$TURBO_ROOT$/templates/nuxt/server/**/*.ts",
        "$TURBO_ROOT$/templates/vscode/src/openai.ts",
        "$TURBO_ROOT$/apps/docs/components/pages/docs/fumadocs/install/packaged-file-url.ts",
        "$TURBO_ROOT$/examples/*/app/api/**/*.ts",
        "!$TURBO_ROOT$/examples/*/app/api/**/*.test.ts",
        "$TURBO_ROOT$/examples/with-mcp/app/app/api/chat/route.ts",
        "$TURBO_ROOT$/examples/with-nuxt/server/**/*.ts",
        "!$TURBO_ROOT$/examples/with-nuxt/server/**/*.test.ts",
        "$TURBO_ROOT$/examples/with-react-router/app/routes/api.chat.ts",
        "$TURBO_ROOT$/examples/with-generative-ui/lib/**/*.ts",
        "!$TURBO_ROOT$/examples/with-generative-ui/lib/**/*.test.ts",
        "$TURBO_ROOT$/packages/react-google-adk/src/**/*.ts",
        "$TURBO_ROOT$/examples/with-expo/**/*.{ts,tsx}",
        "!$TURBO_ROOT$/examples/with-expo/**/{node_modules,.next,dist,build}/**"
      ]
    },
    "test:coverage": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/templates/**/api/**/*.ts",
        "$TURBO_ROOT$/templates/nuxt/server/**/*.ts",
        "$TURBO_ROOT$/templates/vscode/src/openai.ts",
        "$TURBO_ROOT$/apps/docs/components/pages/docs/fumadocs/install/packaged-file-url.ts",
        "$TURBO_ROOT$/examples/*/app/api/**/*.ts",
        "!$TURBO_ROOT$/examples/*/app/api/**/*.test.ts",
        "$TURBO_ROOT$/examples/with-mcp/app/app/api/chat/route.ts",
        "$TURBO_ROOT$/examples/with-nuxt/server/**/*.ts",
        "!$TURBO_ROOT$/examples/with-nuxt/server/**/*.test.ts",
        "$TURBO_ROOT$/examples/with-react-router/app/routes/api.chat.ts",
        "$TURBO_ROOT$/examples/with-generative-ui/lib/**/*.ts",
        "!$TURBO_ROOT$/examples/with-generative-ui/lib/**/*.test.ts",
        "$TURBO_ROOT$/packages/react-google-adk/src/**/*.ts",
        "$TURBO_ROOT$/examples/with-expo/**/*.{ts,tsx}",
        "!$TURBO_ROOT$/examples/with-expo/**/{node_modules,.next,dist,build}/**"
      ]
    }
  }
}
