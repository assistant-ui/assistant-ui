{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "agent-checkout",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "dev": { "port": 8791 },
  // setup.assistant-ui.com is the setup app (apps/setup) on Vercel; the worker
  // keeps checkout.assistant-ui.com, where the agent and the browser meet.
  "routes": [{ "pattern": "checkout.assistant-ui.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [
      { "name": "CHECKOUT", "class_name": "CheckoutDO" },
      // One object keeps the anonymous stage counts (src/stage-counts.ts).
      { "name": "SETUP_STATS", "class_name": "SetupStatsDO" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CheckoutDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SetupStatsDO"] },
  ],
  // Sends PostHog each finished day's stage counts. The project key is the
  // POSTHOG_API_KEY secret; without it the counts are kept and not sent.
  "triggers": { "crons": ["17 * * * *"] },
  // Requests to links that hold no setup yet, per client IP. Opening a link
  // and creating its setup takes a few; the rest of a setup is not counted.
  "ratelimits": [
    {
      "name": "NEW_LINKS",
      "namespace_id": "4161",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
