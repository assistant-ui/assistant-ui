{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "agent-checkout",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "dev": { "port": 8791 },
  // setup.assistant-ui.com is the setup app (apps/setup) on Vercel; the worker
  // keeps checkout.assistant-ui.com, where the agent and the browser meet.
  "routes": [{ "pattern": "checkout.assistant-ui.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "CHECKOUT", "class_name": "CheckoutDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CheckoutDO"] }],
}
