{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "agent-checkout",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "dev": { "port": 8791 },
  // setup.assistant-ui.com is the setup app (apps/setup) on Vercel; the worker
  // keeps checkout.assistant-ui.com, where the agent and the browser meet.
  "routes": [{ "pattern": "checkout.assistant-ui.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "CHECKOUT", "class_name": "CheckoutDO" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CheckoutDO"] }],
  // Requests to links that hold no setup yet, per client IP. Opening a link
  // and creating its setup takes a few; the rest of a setup is not counted.
  "ratelimits": [
    {
      "name": "NEW_LINKS",
      "namespace_id": "4161",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
}
