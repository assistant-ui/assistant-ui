{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate:type-docs", "//#docs-source-inputs"],
      "inputs": [
        "$TURBO_EXTENDS$",
        ".env*",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/scripts/lib/script-options.mjs",
        "$TURBO_ROOT$/packages/*/vitest.peer-*.config.ts"
      ],
      "outputs": [
        "dist/**",
        ".farm/**",
        "!.farm/cache/**",
        ".vercel/output/**",
        "generated/**",
        ".output/**",
        "build/**"
      ],
      "passThroughEnv": ["DOCS_BUILD_CPUS"]
    },
    "generate:type-docs": {
      "dependsOn": ["^build"],
      "env": ["!NEXT_PUBLIC_*"],
      "inputs": [
        "scripts/generate-type-docs.mts",
        "scripts/generated-docs/**",
        "$TURBO_ROOT$/scripts/lib/experimental-annotations.mjs",
        "content/types-to-generate/**",
        "tsconfig.json"
      ],
      "outputs": [
        "generated/typeDocs.ts",
        "generated/integrationTypeDocs.ts",
        "generated/primitiveDocs.ts"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "generate:type-docs"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DOCS_FULL", "DOCS_LITE"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/examples/with-langgraph/app/api/**/*.ts",
        "$TURBO_ROOT$/examples/with-nuxt/server/api/**/*.ts",
        "$TURBO_ROOT$/templates/nuxt/server/api/**/*.ts",
        "$TURBO_ROOT$/examples/with-expo/app/showcase/*.tsx",
        "$TURBO_ROOT$/examples/with-react-ink/src/app.tsx",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/scripts/lib/experimental-annotations.mjs"
      ],
      "env": ["REDIS_*"]
    },
    "test:coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.gitignore",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/examples/with-langgraph/app/api/**/*.ts",
        "$TURBO_ROOT$/examples/with-nuxt/server/api/**/*.ts",
        "$TURBO_ROOT$/templates/nuxt/server/api/**/*.ts",
        "$TURBO_ROOT$/examples/with-expo/app/showcase/*.tsx",
        "$TURBO_ROOT$/examples/with-react-ink/src/app.tsx",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/scripts/lib/experimental-annotations.mjs"
      ],
      "env": ["REDIS_*"]
    }
  }
}
