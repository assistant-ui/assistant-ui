{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "generate:type-docs",
        "bundle-ai-sdk#preview:build",
        "bundle-block-editor#preview:build",
        "bundle-blog-assistant#preview:build",
        "bundle-data-explorer#preview:build",
        "bundle-website-agent#preview:build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/package-example-bundles.mjs",
        "$TURBO_ROOT$/scripts/example-bundles.json"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "generated/**",
        ".output/**",
        "build/**",
        "public/example-bundles/**"
      ]
    },
    "generate:type-docs": {
      "dependsOn": ["^build"],
      "env": ["!NEXT_PUBLIC_*"],
      "inputs": [
        "scripts/generate-type-docs.mts",
        "scripts/generated-docs/**",
        "content/types-to-generate/**",
        "tsconfig.json"
      ],
      "outputs": [
        "generated/typeDocs.ts",
        "generated/integrationTypeDocs.ts",
        "generated/primitiveDocs.ts"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "generate:type-docs"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "env": ["REDIS_*"]
    }
  }
}
