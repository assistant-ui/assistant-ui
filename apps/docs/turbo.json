{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate:type-docs"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/package-example-bundles.mjs",
        "$TURBO_ROOT$/scripts/example-bundles.json",
        "$TURBO_ROOT$/scripts/prepare-example-bundles.mjs",
        "$TURBO_ROOT$/scripts/run-example-bundles.mjs",
        "$TURBO_ROOT$/scripts/build-example-bundle.mjs",
        "$TURBO_ROOT$/examples/bundle-*/**",
        "!$TURBO_ROOT$/examples/bundle-*/dist/**",
        "!$TURBO_ROOT$/examples/bundle-*/node_modules/**",
        "$TURBO_ROOT$/packages/ui/src/**",
        "$TURBO_ROOT$/scripts/lib/script-options.mjs",
        "!$TURBO_ROOT$/examples/bundle-*/build/**"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        "generated/**",
        ".output/**",
        "build/**",
        "public/example-bundles/**"
      ],
      "env": ["NEXT_PUBLIC_AUI_EXAMPLE_BUNDLES_ENABLED"]
    },
    "generate:type-docs": {
      "dependsOn": ["^build"],
      "env": ["!NEXT_PUBLIC_*"],
      "inputs": [
        "scripts/generate-type-docs.mts",
        "scripts/generated-docs/**",
        "content/types-to-generate/**",
        "tsconfig.json"
      ],
      "outputs": [
        "generated/typeDocs.ts",
        "generated/integrationTypeDocs.ts",
        "generated/primitiveDocs.ts"
      ]
    },
    "dev": {
      "dependsOn": ["^build", "generate:type-docs"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "env": ["REDIS_*"]
    }
  }
}
