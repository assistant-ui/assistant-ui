  "script": {
    "fallback": "This preview is scripted, so I can only answer a few requests: a tip splitter, a savings chart, a solar system quiz and a focus timer.",
    "missing": "There is no {widget} in this chat yet, so there is nothing to change. Ask for one first.",
    "applied": "The {widget} already has that change.",
    "stopped": "The {widget} was stopped before it was finished. Ask for it again.",
    "unknownChange": "This preview is scripted, so I can only make the changes it has recorded for the {widget}.",
    "noChanges": "This preview is scripted and has no recorded change for the {widget}.",
    "failed": "That did not work: {error}"
  },
  "replies": [
    {
      "id": "tip-25",
      "marker": "data-tip=\"25\"",
      "match": [["25%"], ["25", "option"], ["25", "tip"]],
      "text": "Adding 25% to the tip options.",
      "tool": {
        "name": "edit_widget",
        "args": {
          "title": "tip_splitter",
          "edits": [
            {
              "old_string": "<button type=\"button\" data-tip=\"20\" aria-pressed=\"false\">20%</button>",
              "new_string": "<button type=\"button\" data-tip=\"20\" aria-pressed=\"false\">20%</button>\n      <button type=\"button\" data-tip=\"25\" aria-pressed=\"false\">25%</button>"
            }
          ]
        }
      },
      "after": "Done. The splitter has a 25% option next to 20%.",
      "followUps": [
        "Round up each share",
        "Chart how $10,000 grows with compound interest"
      ]
    },
    {
      "id": "tip-round",
      "marker": "id=\"round\"",
      "match": [["round", "share"], ["round up"], ["rounding"]],
      "text": "Adding a checkbox that rounds each share up.",
      "tool": {
        "name": "edit_widget",
        "args": {
          "title": "tip_splitter",
          "edits": [
            {
              "old_string": "@media (max-width:380px){.tip .row{grid-template-columns:1fr}}",
              "new_string": ".tip .check{display:flex;align-items:center;gap:8px;margin:0;font-size:14px;color:var(--color-text)}\n@media (max-width:380px){.tip .row{grid-template-columns:1fr}}"
            },
            {
              "old_string": "</fieldset>",
              "new_string": "</fieldset>\n  <label class=\"check\"><input type=\"checkbox\" id=\"round\"> Round each share up to a whole dollar</label>"
            },
            {
              "old_string": "people: 4 }",
              "new_string": "people: 4, round: false }"
            },
            {
              "old_string": "const each = total / state.people;",
              "new_string": "const each = state.round ? Math.ceil(total / state.people) : total / state.people;\n  $(\"round\").checked = state.round;"
            },
            {
              "old_string": "render();\n</script>",
              "new_string": "$(\"round\").addEventListener(\"change\", (event) => change({ round: event.target.checked }));\nrender();\n</script>"
            }
          ]
        }
      },
      "after": "Done. Tick the box and every share rounds up to the next whole dollar.",
      "followUps": ["Add a 25% option", "Make me a focus timer"]
    },
    {
      "id": "savings-monthly",
      "marker": "id=\"monthly\"",
      "match": [["monthly"], ["deposit"]],
      "text": "Adding a monthly deposit to the chart.",
      "tool": {
        "name": "edit_widget",
        "args": {
          "title": "savings_growth",
          "edits": [
            {
              "old_string": ".grow .axis{",
              "new_string": ".grow .paid{fill:none;stroke:var(--chart-2);stroke-width:1.5;stroke-dasharray:4 4}\n.grow .legend{display:flex;gap:14px;margin:0 0 6px;font-size:12px;color:var(--color-text-muted)}\n.grow .legend span{display:inline-flex;align-items:center;gap:6px}\n.grow .legend i{width:14px;border-top:2px solid var(--chart-1)}\n.grow .legend i.dash{border-top:2px dashed var(--chart-2)}\n.grow .axis{"
            },
            {
              "old_string": "<div class=\"chart\" id=\"chart\">",
              "new_string": "<p class=\"legend\"><span><i></i>Balance</span><span><i class=\"dash\"></i>Deposits</span></p>\n    <div class=\"chart\" id=\"chart\">"
            },
            {
              "old_string": "<output id=\"rate-out\" for=\"rate\">6%</output></div>",
              "new_string": "<output id=\"rate-out\" for=\"rate\">6%</output></div>\n  <div class=\"ctl\"><label for=\"monthly\">Monthly deposit</label><input id=\"monthly\" type=\"range\" min=\"0\" max=\"1000\" step=\"50\" value=\"200\"><output id=\"monthly-out\" for=\"monthly\">$200</output></div>"
            },
            {
              "old_string": "rate: 6 }",
              "new_string": "rate: 6, monthly: 200 }"
            },
            {
              "old_string": "return state.start * Math.pow(1 + m, n);",
              "new_string": "const growth = Math.pow(1 + m, n);\n  return state.start * growth + (state.monthly * (growth - 1)) / m;"
            },
            {
              "old_string": "const paidIn = state.start;",
              "new_string": "const paidIn = state.start + state.monthly * 12 * state.years;\n  $(\"monthly-out\").textContent = money.format(state.monthly);"
            },
            {
              "old_string": "+ `<path class=\"line\" d=\"${path}\"/>`",
              "new_string": "+ `<path class=\"line\" d=\"${path}\"/>`\n    + `<path class=\"paid\" d=\"M${x(0)} ${y(state.start)}L${x(state.years)} ${y(paidIn)}\"/>`"
            },
            {
              "old_string": "[\"start\", \"years\", \"rate\"]",
              "new_string": "[\"start\", \"years\", \"rate\", \"monthly\"]"
            }
          ]
        }
      },
      "after": "Done. There is a new slider, and the dashed line shows what you put in, so the gap above it is the interest.",
      "followUps": ["Quiz me on the solar system", "Make me a focus timer"]
