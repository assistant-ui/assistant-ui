{
  "name": "@assistant-ui/docs-site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:remote-components && next dev",
    "dev:full": "node ./scripts/with-env.mjs DOCS_FULL=1 pnpm dev",
    "dev:lite": "node ./scripts/with-env.mjs DOCS_LITE=1 pnpm dev",
    "build": "pnpm generate:source-snapshot && pnpm build:remote-components && next build && pnpm verify:repo-source-traces && pnpm check:bundle-budget",
    "build:remote-components": "node ./scripts/build-remote-components.mjs",
    "build:brand-kit": "tsx ./scripts/build-brand-kit.mts",
    "generate:type-docs": "tsx ./scripts/generate-type-docs.mts",
    "generate:api-reference": "tsx ./scripts/generate-api-reference.mts",
    "generate:agent-skills": "tsx ./scripts/generate-agent-skills.mts",
    "generate:source-snapshot": "tsx ./scripts/generate-source-snapshot.mts",
    "verify:repo-source-traces": "tsx ./scripts/check-repo-source-traces.mts",
    "check:bundle-budget": "tsx ./scripts/check-bundle-budget.mts",
    "start": "next start",
    "check:links": "start-server-and-test \"next start -p 3331\" http://localhost:3331 \"linkinator http://localhost:3331 --config linkinator.config.mjs\"",
    "check:lighthouse": "lhci autorun",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.test.json",
    "capture:cloud-screenshots": "tsx ./scripts/capture-cloud-screenshots.mts"
  },
