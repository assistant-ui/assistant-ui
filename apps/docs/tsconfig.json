{
  "extends": "@assistant-ui/x-buildutils/ts/next",
  "compilerOptions": {
    "paths": {
      "@/components/ui/*": [
        "../../packages/ui/src/components/react/ui/base/*",
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/components/ui/radix/*": [
        "../../packages/ui/src/components/react/ui/radix/*"
      ],
      "@/lib/utils": ["../../packages/ui/src/lib/utils"],
      "@/components/assistant-ui/elements/markdown-text": [
        "./components/assistant-ui/elements/markdown-text"
      ],
      "@/hooks/use-mobile": ["../../packages/ui/src/hooks/use-mobile"],
      "@/hooks/use-copy-to-clipboard": [
        "../../packages/ui/src/hooks/use-copy-to-clipboard"
      ],
      "@/hooks/use-attachment-src": [
        "../../packages/ui/src/hooks/use-attachment-src"
      ],
      "@/components/assistant-ui/*": [
        "../../packages/ui/src/components/react/assistant-ui/*"
      ],
      "@/components/demo/elements/*": ["./components/demo/elements/*"],
      "@/components/icons/*": [
        "./components/icons/*",
        "../../packages/ui/src/components/react/icons/*"
      ],
      "@/*": ["./*"],
      "@assistant-ui/ui/*": ["../../packages/ui/src/*"],
      "fumadocs-mdx:collections/*": ["./.source/*"],
      "@assistant-ui/react-generative-ui/*": [
        "../../packages/react-generative-ui/src/*"
      ],
      "@assistant-ui/store/client": ["../../packages/store/src/client"],
      "@assistant-ui/store/internal": ["../../packages/store/src/internal"],
      "@assistant-ui/*": ["../../packages/*/src"],
      "@assistant-ui/core/*": ["../../packages/core/src/*"],
      "@assistant-ui/react/*": ["../../packages/react/src/*"],
      "@assistant-ui/tap/*": ["../../packages/tap/src/*"],
      "assistant-stream": ["../../packages/assistant-stream/src"],
      "assistant-stream/*": ["../../packages/assistant-stream/src/*"],
      "assistant-cloud": ["../../packages/cloud/src"],
      "assistant-cloud/*": ["../../packages/cloud/src/*"],
      "safe-content-frame": ["../../packages/safe-content-frame/src"],
      "safe-content-frame/*": ["../../packages/safe-content-frame/src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
