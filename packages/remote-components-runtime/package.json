{
  "name": "@assistant-ui/remote-components-runtime",
  "version": "0.0.1",
  "private": true,
  "description": "The runtime that makes any HTML document a remote component (window.rc)",
  "keywords": [
    "remote-components",
    "iframe",
    "sandbox",
    "assistant-ui"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./source": {
      "types": "./dist/source.d.ts",
      "default": "./dist/source.js"
    },
    "./global": {
      "types": "./dist/global.d.ts"
    },
    "./rc-runtime.js": "./dist/script/rc-runtime.js",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "aui-build && node build-script.mjs",
    "size": "node build-script.mjs --size",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/remote-components-protocol": "workspace:^"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "jsdom": "^30.1.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "homepage": "https://www.assistant-ui.com/remote-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/remote-components-runtime"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
