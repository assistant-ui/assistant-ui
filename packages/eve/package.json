{
  "name": "@assistant-ui/eve",
  "version": "0.0.23",
  "description": "Eve runtime adapter for assistant-ui",
  "keywords": [
    "eve",
    "assistant-ui",
    "react",
    "ai",
    "chat",
    "agents"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:watch": "vitest",
    "test:types:peer-react18": "aui-react18-types"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.25",
    "@assistant-ui/store": "^0.3.18",
    "assistant-cloud": "*"
  },
  "peerDependencies": {
    "@types/react": "*",
    "eve": ">=0.32.0",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "@assistant-ui/x-react18": "workspace:*",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "eve": "^0.74.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/eve"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
