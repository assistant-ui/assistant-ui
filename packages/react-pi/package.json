{
  "name": "@assistant-ui/react-pi",
  "version": "0.0.27",
  "description": "Pi coding-agent runtime adapter for assistant-ui",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "assistant-ui",
    "react",
    "ai",
    "chat",
    "agents",
    "coding-agent"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/react-pi"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/core": "workspace:^",
    "@assistant-ui/store": "^0.3.17",
    "@standard-schema/spec": "^1.1.0",
    "assistant-cloud": "*",
    "assistant-stream": "^0.3.47"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.22",
    "@earendil-works/pi-coding-agent": ">=0.80.8",
    "@types/react": "*",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/x-buildutils": "workspace:*",
    "@assistant-ui/x-react18": "workspace:*",
    "@earendil-works/pi-coding-agent": "^1.0.0",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
