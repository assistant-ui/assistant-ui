{
  "name": "@assistant-ui/remote-components-vite",
  "version": "0.0.1",
  "private": true,
  "description": "Optional Vite plugin for remote components: runtime tag, component pages, single-file builds",
  "keywords": [
    "remote-components",
    "iframe",
    "sandbox",
    "assistant-ui"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@assistant-ui/remote-components-serve": "workspace:^"
  },
  "peerDependencies": {
    "vite": ">=6",
    "@assistant-ui/remote-components-react": "workspace:^"
  },
  "devDependencies": {
    "@assistant-ui/remote-components-react": "workspace:*",
    "@assistant-ui/x-buildutils": "workspace:*",
    "@types/node": "^26.6.6",
    "vite": "^8.3.6"
  },
  "homepage": "https://www.assistant-ui.com/remote-components",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/remote-components-vite"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
