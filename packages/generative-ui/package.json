{
  "name": "@assistant-ui/generative-ui",
  "version": "0.0.3",
  "description": "Framework-neutral generative UI for assistant-ui",
  "keywords": [
    "generative-ui",
    "assistant-ui",
    "ai",
    "chat",
    "rendering"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "react-server": {
        "types": "./dist/react.server.d.ts",
        "default": "./dist/react.server.js"
      },
      "default": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      }
    },
    "./a2ui": {
      "types": "./dist/a2ui.d.ts",
      "default": "./dist/a2ui.js"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "default": "./dist/slack.js"
    },
    "./teams": {
      "types": "./dist/teams.d.ts",
      "default": "./dist/teams.js"
    },
    "./spec": {
      "types": "./dist/spec.d.ts",
      "default": "./dist/spec.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/json-schema": "^7.0.15",
    "assistant-stream": "^0.3.49"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.0",
    "@types/react": "*",
    "generative-frame": "^0.0.4",
    "react": "^18 || ^19",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@assistant-ui/react": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "generative-frame": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/x-buildutils": "workspace:*",
    "@assistant-ui/x-react18": "workspace:*",
    "@types/react": "^19.3.0",
    "generative-frame": "workspace:*",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/generative-ui"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
