{
  "name": "@assistant-ui/markdown",
  "version": "0.0.0",
  "private": true,
  "description": "Streaming markdown parsing for assistant-ui",
  "keywords": [
    "markdown",
    "streaming",
    "parser",
    "assistant-ui",
    "ai",
    "chat"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "bench": "vitest bench --run src/session.bench.ts",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "markdown-it": "^15.0.3"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "commonmark-spec": "^0.31.2",
    "vitest": "^5.0.5"
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/markdown"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
