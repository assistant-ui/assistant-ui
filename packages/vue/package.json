{
  "name": "@assistant-ui/vue",
  "version": "0.0.0",
  "private": true,
  "description": "Vue bindings for assistant-ui",
  "keywords": [
    "vue",
    "assistant-ui",
    "store",
    "tap",
    "state-management"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
