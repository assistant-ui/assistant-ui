{
  "name": "@assistant-ui/vue",
  "version": "0.0.0",
  "description": "Vue bindings for assistant-ui",
  "keywords": [
    "assistant",
    "ai",
    "chat",
    "vue",
    "nuxt"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.23",
    "@assistant-ui/store": "^0.3.17",
    "@assistant-ui/tap": "^0.9.21"
  },
  "peerDependencies": {
    "@types/react": "^19.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "assistant-cloud": "workspace:*",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
