{
  "name": "@assistant-ui/solid",
  "version": "0.0.0",
  "private": true,
  "description": "Solid bindings for assistant-ui",
  "keywords": [
    "assistant",
    "ai",
    "chat",
    "solid",
    "solid-js"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.38",
    "@assistant-ui/store": "^0.3.25",
    "@assistant-ui/tap": "^0.9.27"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.3",
    "solid-js": "^1.9.19",
    "vitest": "^5.0.5"
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/solid"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
