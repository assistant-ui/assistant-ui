{
  "name": "@assistant-ui/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./components/assistant-ui/*": "./src/components/react/assistant-ui/*",
    "./components/ui/*": "./src/components/react/ui/*",
    "./hooks/*": "./src/hooks/*",
    "./lib/*": "./src/lib/*"
  },
  "dependencies": {
    "@assistant-ui/ai-sdk": "workspace:*",
    "@assistant-ui/generative-ui": "workspace:*",
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/react-markdown": "workspace:*",
    "@assistant-ui/react-mcp": "workspace:*",
    "@assistant-ui/react-syntax-highlighter": "workspace:*",
    "@assistant-ui/store": "workspace:*",
    "@base-ui/react": "^1.8.0",
    "beautiful-mermaid": "^1.1.3",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "diff": "^9.0.0",
    "embla-carousel-react": "^8.6.0",
    "heat-graph": "workspace:*",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.52.0",
    "next-themes": "^0.4.6",
    "parse-diff": "^0.12.0",
    "radix-ui": "^1.7.0",
    "react-day-picker": "^10.0.2",
    "react-hook-form": "^7.89.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.2",
    "react-shiki": "^0.11.2",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@assistant-ui/core": "workspace:*",
    "@assistant-ui/react-native": "workspace:*",
    "@assistant-ui/tap": "workspace:*",
    "@assistant-ui/vue": "workspace:*",
    "@assistant-ui/x-buildutils": "workspace:*",
    "@assistant-ui/x-react18": "workspace:*",
    "@lucide/vue": "^1.52.0",
    "@testing-library/react": "^16.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-vue": "^6.0.9",
    "expo-clipboard": "^57.0.2",
    "expo-image-manipulator": "^57.0.21",
    "expo-image-picker": "^57.0.20",
    "jsdom": "^30.1.2",
    "leaflet": "^1.9.4",
    "lucide-react-native": "^1.52.0",
    "markdown-it": "^15.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "^0.87.1",
    "react-native-marked": "^8.3.2",
    "react-native-safe-area-context": "^5.10.1",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.3",
    "reka-ui": "^2.11.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "uniwind": "^1.12.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json && tsc --noEmit -p src/components/react-native/tsconfig.json && tsc --noEmit -p src/components/react-native/tsconfig.test.json && vue-tsc --noEmit -p tsconfig.vue.json",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types tsconfig.peer-react18.json src/components/react-native/tsconfig.peer-react18.json"
  }
}
