{
  "name": "diagrammatic",
  "version": "0.0.4",
  "private": true,
  "description": "Every chart you can reach for: 68 zero-dependency, server-first React chart forms themed by CSS tokens.",
  "keywords": [
    "charts",
    "react",
    "svg",
    "server-components",
    "dataviz",
    "sparkline",
    "sankey",
    "treemap"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./spec": {
      "types": "./dist/spec/index.d.ts",
      "default": "./dist/spec/index.js"
    },
    "./interactive": {
      "types": "./dist/interactive/index.d.ts",
      "default": "./dist/interactive/index.js"
    },
    "./world": {
      "types": "./dist/world/index.d.ts",
      "default": "./dist/world/index.js"
    },
    "./styles.css": {
      "style": "./src/styles.css",
      "default": "./src/styles.css"
    },
    "./shadcn.css": {
      "style": "./src/shadcn.css",
      "default": "./src/shadcn.css"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": [
    "./src/styles.css",
    "./src/shadcn.css"
  ],
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@types/react": "*",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "@assistant-ui/x-react18": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/diagrammatic"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
