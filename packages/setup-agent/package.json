{
  "name": "setup-agent",
  "version": "0.0.5",
  "description": "A live setup shared between a browser and the coding agent installing the products in it, on Statewire",
  "license": "MIT",
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/setup-agent"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "bin": {
    "setup-agent": "./bin/setup-agent.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "bin",
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "aui-build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary"
  },
  "dependencies": {
    "@assistant-ui/tap": "^0.9.22",
    "statewire": "^0.19.4"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false
}
