{
  "name": "@assistant-ui/react-generative-ui",
  "version": "0.1.0",
  "description": "Generative UI components for assistant-ui",
  "keywords": [
    "generative-ui",
    "assistant-ui",
    "react",
    "ai",
    "chat",
    "rendering"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "react-server": {
        "types": "./dist/index.server.d.ts",
        "default": "./dist/index.server.js"
      },
      "default": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./ir": {
      "types": "./dist/ir.d.ts",
      "default": "./dist/ir.js"
    },
    "./a2ui": {
      "types": "./dist/a2ui.d.ts",
      "default": "./dist/a2ui.js"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "default": "./dist/slack.js"
    },
    "./teams": {
      "types": "./dist/teams.d.ts",
      "default": "./dist/teams.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/generative-ui": "^0.0.1"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.0",
    "@types/react": "*",
    "react": "^18 || ^19",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/x-buildutils": "workspace:*",
    "@assistant-ui/x-react18": "workspace:*",
    "@types/react": "^19.3.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/react-generative-ui"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
