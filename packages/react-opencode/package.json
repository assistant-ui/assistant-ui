{
  "name": "@assistant-ui/react-opencode",
  "version": "0.2.27",
  "description": "OpenCode runtime adapter for assistant-ui",
  "keywords": [
    "opencode",
    "assistant-ui",
    "react",
    "ai",
    "chat",
    "agents"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "homepage": "https://www.assistant-ui.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/react-opencode"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test:peer-react18": "vitest run --config vitest.peer-react18.config.ts",
    "test:types:peer-react18": "aui-react18-types",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@assistant-ui/core": "^0.3.23",
    "@assistant-ui/store": "^0.3.17",
    "@opencode-ai/sdk": "^1.18.33",
    "assistant-cloud": "*"
  },
  "peerDependencies": {
    "@assistant-ui/react": "^0.15.0",
    "@types/react": "*",
    "react": "^18 || ^19"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@assistant-ui/react": "workspace:*",
    "@assistant-ui/x-buildutils": "workspace:*",
    "@assistant-ui/x-react18": "workspace:*",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vitest": "^5.0.3"
  }
}
