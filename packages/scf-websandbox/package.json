{
  "name": "scf-websandbox",
  "version": "0.0.0",
  "description": "Drop-in replacement for websandbox that runs untrusted JavaScript in a Safe Content Frame with its own origin",
  "keywords": [
    "sandbox",
    "websandbox",
    "iframe",
    "untrusted",
    "security",
    "rpc"
  ],
  "author": "AgentbaseAI Inc.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "aui-build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=html --coverage.reporter=json-summary",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "safe-content-frame": "workspace:^"
  },
  "devDependencies": {
    "@assistant-ui/x-buildutils": "workspace:*",
    "jsdom": "^30.1.2",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "homepage": "https://github.com/assistant-ui/assistant-ui/tree/main/packages/scf-websandbox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/assistant-ui/assistant-ui.git",
    "directory": "packages/scf-websandbox"
  },
  "bugs": {
    "url": "https://github.com/assistant-ui/assistant-ui/issues"
  }
}
